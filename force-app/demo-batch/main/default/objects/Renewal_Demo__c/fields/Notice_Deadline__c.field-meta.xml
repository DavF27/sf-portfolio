<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Notice_Deadline__c</fullName>
    <description
  >Last day to send the renewal notice: end of the contract minus the notice period. Filterable in SOQL.</description>
    <formula>ADDMONTHS(Start_Date__c, Term_Months__c) - Notice_Days__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Notice Deadline</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Date</type>
</CustomField>
