    <apiVersion>66.0</apiVersion>
    <description
  >BEFORE mode of the order of execution demo (deliberately misplaced): computes the service terms after the save, once the after trigger has already snapshotted the asset, then saves the asset again.</description>
    <environments>Default</environments>
    <formulas>
        <name>NextMaintenance</name>
        <dataType>Date</dataType>
        <expression
    >ADDMONTHS({!$Record.Installed_On__c}, IF(ISPICKVAL({!$Record.Product_Family__c}, &quot;Premium&quot;), 3, 6))</expression>
    </formulas>
    <formulas>
        <name>ServiceTier</name>
        <dataType>String</dataType>
        <expression
    >IF(ISPICKVAL({!$Record.Product_Family__c}, &quot;Premium&quot;), &quot;Gold&quot;, &quot;Silver&quot;)</expression>
    </formulas>
    <formulas>
        <name>WarrantyEnd</name>
        <dataType>Date</dataType>
        <expression
    >ADDMONTHS({!$Record.Installed_On__c}, IF(ISPICKVAL({!$Record.Product_Family__c}, &quot;Premium&quot;), 36, 24))</expression>
    </formulas>
